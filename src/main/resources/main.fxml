<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="abc.ui.Controller" spacing="10">
    <children>
        <Canvas fx:id="canvas" width="800" height="600" />

        <!-- Controls -->
        <HBox alignment="CENTER" spacing="15">
            <Button fx:id="startButton" text="▶ Start" onAction="#startSimulation" style="-fx-font-weight: bold;"/>
            <Button fx:id="pauseButton" text="⏸ Pause" disable="true" onAction="#pauseSimulation"/>
            <Button fx:id="resetButton" text="🔄 Reset" onAction="#resetAlgorithm"/>
            <Label text="Speed:"/>
            <Slider fx:id="speedSlider" min="1" max="30" value="10" prefWidth="100"/>
            <CheckBox fx:id="showNeighborhood" text="Show Neighborhood" selected="true"/>
        </HBox>

        <!-- Parameters -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="Food Sources:" style="-fx-font-weight: bold;"/>
            <TextField fx:id="foodCountField" text="20" prefWidth="50"/>
            <Label text="Abandon Limit:" style="-fx-font-weight: bold;"/>
            <TextField fx:id="limitField" text="100" prefWidth="50"/>
            <Label text="Neighborhood Radius:" style="-fx-font-weight: bold;"/>
            <TextField fx:id="radiusField" text="0.05" prefWidth="50"/>
            <Button text="Apply Parameters" onAction="#initializeAlgorithm" style="-fx-font-weight: bold;"/>
        </HBox>

        <!-- Analytics -->
        <HBox alignment="CENTER" spacing="20">
            <VBox alignment="CENTER" spacing="5">
                <Label text="BEST FITNESS" style="-fx-font-weight: bold; -fx-text-fill: green;"/>
                <Label fx:id="bestFitnessLabel" text="0.0" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
            </VBox>
            <VBox alignment="CENTER" spacing="5">
                <Label text="AVERAGE FITNESS" style="-fx-font-weight: bold; -fx-text-fill: blue;"/>
                <Label fx:id="avgFitnessLabel" text="0.0" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
            </VBox>
            <VBox alignment="CENTER" spacing="5">
                <Label text="NEAR ABANDONMENT" style="-fx-font-weight: bold; -fx-text-fill: red;"/>
                <Label fx:id="abandonedLabel" text="0" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
            </VBox>
            <VBox alignment="CENTER" spacing="5">
                <Label text="CURRENT PHASE" style="-fx-font-weight: bold;"/>
                <Label fx:id="phaseLabel" text="Initialization" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
            </VBox>
            <VBox alignment="CENTER" spacing="5">
                <Label text="ITERATION" style="-fx-font-weight: bold;"/>
                <Label fx:id="iterationText" text="Iteration: 0/1000" style="-fx-font-size: 12;"/>
            </VBox>
            <Label fx:id="statusLabel" text="Ready" style="-fx-font-weight: bold; -fx-text-fill: darkblue;"/>
        </HBox>
    </children>
</VBox>